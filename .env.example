NODE_ENV=development
PORT=3000

# Local (docker compose). Para Supabase: Session pooler (puerto 5432) y PGSSL=true
DATABASE_URL=postgres://pasaje:pasaje@localhost:5433/pasaje
DATABASE_URL_PRUEBAS=postgres://pasaje:pasaje@localhost:5433/pasaje_pruebas
PGSSL=false

JWT_SECRETO=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=7d

# Llave secreta Ed25519 (base64url, 64 bytes). En development/test se usa shared/dev-keys.json
LLAVE_FIRMA_BOLETOS=
